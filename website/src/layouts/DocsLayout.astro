---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/astro/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;

const sidebar = [
  {
    title: 'Getting Started',
    items: [
      { name: 'Installation', href: '/docs/getting-started/installation' },
      { name: 'Quick Start', href: '/docs/getting-started/quickstart' },
      { name: 'Configuration', href: '/docs/getting-started/configuration' },
    ],
  },
  {
    title: 'User Guide',
    items: [
      { name: 'Overview', href: '/docs/user-guide/overview' },
      { name: 'API Reference', href: '/docs/user-guide/api-reference' },
      { name: 'Data Sharing', href: '/docs/user-guide/data-sharing' },
      { name: 'P2P Network', href: '/docs/user-guide/p2p-network' },
      { name: 'Dashboards', href: '/docs/user-guide/dashboards' },
    ],
  },
  {
    title: 'Development',
    items: [
      { name: 'Architecture', href: '/docs/development/architecture' },
      { name: 'Plugin Development', href: '/docs/development/plugins' },
      { name: 'Smart Contracts', href: '/docs/development/contracts' },
      { name: 'Testing', href: '/docs/development/testing' },
      { name: 'Contributing', href: '/docs/development/contributing' },
    ],
  },
  {
    title: 'Operations',
    items: [
      { name: 'Deployment', href: '/docs/operations/deployment' },
      { name: 'Monitoring', href: '/docs/operations/monitoring' },
      { name: 'Security', href: '/docs/operations/security' },
      { name: 'Performance', href: '/docs/operations/performance' },
      { name: 'Troubleshooting', href: '/docs/operations/troubleshooting' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={{
    "@type": "TechArticle",
    "headline": title,
    "description": description,
    "dateModified": lastUpdated || new Date().toISOString(),
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-8">
      <!-- Sidebar -->
      <aside class="hidden lg:block lg:col-span-3">
        <nav class="sticky top-24 space-y-6">
          {sidebar.map((section) => (
            <div>
              <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider">
                {section.title}
              </h3>
              <ul class="mt-3 space-y-2">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'block text-sm py-1 px-2 rounded transition-colors',
                        currentPath === item.href
                          ? 'bg-primary-50 text-primary-700 font-medium'
                          : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
                      ]}
                    >
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Main content -->
      <main class="lg:col-span-9">
        <article class="prose max-w-none">
          <h1>{title}</h1>
          {lastUpdated && (
            <p class="text-sm text-gray-500 -mt-4 mb-8">
              Last updated: {new Date(lastUpdated).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </p>
          )}
          <slot />
        </article>
      </main>
    </div>
  </div>
</BaseLayout>
