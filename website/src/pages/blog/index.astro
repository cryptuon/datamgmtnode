---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);
---

<BaseLayout
  title="Blog - DataMgmt Node"
  description="Technical articles, tutorials, and updates about decentralized data management, blockchain compliance, and P2P networking."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight">
        Blog
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-600">
        Technical articles, tutorials, and updates about decentralized data management.
      </p>
    </div>
  </section>

  <!-- Posts -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {sortedPosts.length > 0 ? (
        <div class="space-y-12">
          {sortedPosts.map((post) => (
            <article class="border-b border-gray-200 pb-12">
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.map((tag) => (
                  <span class="text-xs font-medium px-2 py-1 rounded-full bg-primary-50 text-primary-700">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-2xl font-bold text-gray-900">
                <a href={`/blog/${post.id.replace('.md', '')}`} class="hover:text-primary-600">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-gray-600">
                {post.data.description}
              </p>
              <div class="mt-4 flex items-center gap-4 text-sm text-gray-500">
                <span>{post.data.author}</span>
                <span>&middot;</span>
                <time datetime={post.data.publishedDate}>
                  {new Date(post.data.publishedDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              </div>
              <a href={`/blog/${post.id.replace('.md', '')}`} class="mt-4 inline-flex items-center text-primary-600 font-medium">
                Read more
                <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-gray-600 text-center">No posts yet. Check back soon!</p>
      )}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900">Stay Updated</h2>
      <p class="mt-4 text-gray-600">
        Get the latest articles and updates about decentralized data management.
      </p>
      <div class="mt-6">
        <a href="https://github.com/cryptuon/datamgmtnode" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          Star on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
