---
import BaseLayout from '../../layouts/BaseLayout.astro';

const comparisons = [
  {
    title: 'DataMgmt Node vs Centralized Solutions',
    description: 'Compare DataMgmt Node with centralized data management platforms like AWS S3, Snowflake, and BigQuery.',
    href: '/compare/vs-centralized',
    competitor: 'AWS S3 / Snowflake',
  },
  {
    title: 'DataMgmt Node vs IPFS',
    description: 'See how DataMgmt Node differs from IPFS and Filecoin for enterprise data management.',
    href: '/compare/vs-ipfs',
    competitor: 'IPFS / Filecoin',
  },
  {
    title: 'DataMgmt Node vs Traditional Blockchain Storage',
    description: 'Compare off-chain P2P storage with on-chain data storage solutions.',
    href: '/compare/vs-traditional',
    competitor: 'On-chain Storage',
  },
];

const fullComparison = [
  { feature: 'Decentralized Architecture', datamgmt: true, ipfs: true, aws: false, onchain: true },
  { feature: 'Compliance Audit Trail', datamgmt: 'Blockchain', ipfs: 'No', aws: 'CloudTrail', onchain: 'Built-in' },
  { feature: 'Token Payments', datamgmt: true, ipfs: false, aws: false, onchain: 'Varies' },
  { feature: 'End-to-End Encryption', datamgmt: true, ipfs: 'Optional', aws: 'At-rest', onchain: 'Optional' },
  { feature: 'Self-Hosted', datamgmt: true, ipfs: true, aws: false, onchain: true },
  { feature: 'P2P Data Distribution', datamgmt: 'Kademlia DHT', ipfs: 'Bitswap', aws: 'CDN', onchain: 'No' },
  { feature: 'Enterprise APIs', datamgmt: true, ipfs: 'Limited', aws: true, onchain: 'Varies' },
  { feature: 'Plugin System', datamgmt: true, ipfs: false, aws: false, onchain: false },
  { feature: 'Data Monetization', datamgmt: 'Built-in', ipfs: 'External', aws: 'No', onchain: 'Smart Contracts' },
  { feature: 'Regulatory Compliance', datamgmt: 'GDPR/HIPAA/SOX', ipfs: 'Limited', aws: 'Comprehensive', onchain: 'Manual' },
];
---

<BaseLayout
  title="Compare DataMgmt Node - Feature Comparison"
  description="Compare DataMgmt Node with IPFS, AWS S3, and other data management solutions. See detailed feature comparisons for enterprise use cases."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight">
        How DataMgmt Node Compares
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-600">
        See how DataMgmt Node stacks up against other data management solutions for enterprise use cases.
      </p>
    </div>
  </section>

  <!-- Comparison Cards -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        {comparisons.map((comparison) => (
          <a href={comparison.href} class="block bg-white rounded-xl p-6 shadow-sm border border-gray-200 hover:shadow-md hover:border-primary-200 transition-all group">
            <div class="text-sm text-gray-500 mb-2">vs {comparison.competitor}</div>
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">
              {comparison.title}
            </h2>
            <p class="mt-2 text-gray-600 text-sm">
              {comparison.description}
            </p>
            <span class="mt-4 inline-flex items-center text-primary-600 font-medium text-sm">
              Read comparison
              <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Full Comparison Table -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 text-center">Full Feature Comparison</h2>
      <p class="mt-4 text-gray-600 text-center max-w-2xl mx-auto">
        Comprehensive comparison across all major data management approaches.
      </p>

      <div class="mt-12 overflow-x-auto">
        <table class="w-full bg-white rounded-xl shadow-sm">
          <thead>
            <tr>
              <th class="text-left p-4 bg-gray-100 font-semibold rounded-tl-xl">Feature</th>
              <th class="p-4 bg-primary-100 font-semibold text-primary-800">DataMgmt Node</th>
              <th class="p-4 bg-gray-100 font-semibold">IPFS</th>
              <th class="p-4 bg-gray-100 font-semibold">AWS S3</th>
              <th class="p-4 bg-gray-100 font-semibold rounded-tr-xl">On-chain</th>
            </tr>
          </thead>
          <tbody>
            {fullComparison.map((row, index) => (
              <tr class={index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="p-4 font-medium">{row.feature}</td>
                <td class="p-4 text-center bg-primary-50/50">
                  {typeof row.datamgmt === 'boolean' ? (
                    row.datamgmt ? (
                      <span class="text-green-600 font-bold">✓</span>
                    ) : (
                      <span class="text-red-500">✗</span>
                    )
                  ) : (
                    <span class="text-primary-700 font-medium">{row.datamgmt}</span>
                  )}
                </td>
                <td class="p-4 text-center">
                  {typeof row.ipfs === 'boolean' ? (
                    row.ipfs ? (
                      <span class="text-green-600 font-bold">✓</span>
                    ) : (
                      <span class="text-red-500">✗</span>
                    )
                  ) : (
                    <span class="text-gray-600">{row.ipfs}</span>
                  )}
                </td>
                <td class="p-4 text-center">
                  {typeof row.aws === 'boolean' ? (
                    row.aws ? (
                      <span class="text-green-600 font-bold">✓</span>
                    ) : (
                      <span class="text-red-500">✗</span>
                    )
                  ) : (
                    <span class="text-gray-600">{row.aws}</span>
                  )}
                </td>
                <td class="p-4 text-center">
                  {typeof row.onchain === 'boolean' ? (
                    row.onchain ? (
                      <span class="text-green-600 font-bold">✓</span>
                    ) : (
                      <span class="text-red-500">✗</span>
                    )
                  ) : (
                    <span class="text-gray-600">{row.onchain}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-6 text-sm text-gray-500 text-center">
        Last updated: April 2026
      </p>
    </div>
  </section>

  <!-- Decision Guide -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900">When to Choose DataMgmt Node</h2>

      <div class="mt-8 space-y-6">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">You need compliance audit trails</h3>
            <p class="mt-1 text-gray-600">DataMgmt Node records all operations on blockchain, providing immutable proof for GDPR, HIPAA, and SOX compliance.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">You want to monetize data</h3>
            <p class="mt-1 text-gray-600">Built-in ERC-20 token support enables pay-per-access models without external payment integration.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">You need data sovereignty</h3>
            <p class="mt-1 text-gray-600">Self-hosted nodes mean you control your data without vendor lock-in or dependency on cloud providers.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">You require enterprise features</h3>
            <p class="mt-1 text-gray-600">Rate limiting, API authentication, WebSocket support, and plugin architecture out of the box.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white">Ready to try DataMgmt Node?</h2>
      <p class="mt-4 text-xl text-primary-100">
        Get started in minutes with our quick start guide.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/getting-started" class="px-6 py-3 bg-white text-primary-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Get Started
        </a>
        <a href="/demo" class="px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
          Try Demo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
