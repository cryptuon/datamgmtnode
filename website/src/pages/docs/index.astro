---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const indexDoc = docs.find(doc => doc.id === 'index.md');
---

<DocsLayout
  title="Documentation"
  description="Complete documentation for DataMgmt Node - installation, configuration, API reference, and deployment guides."
  lastUpdated="2026-04-15"
>
  {indexDoc ? (
    <Fragment set:html={indexDoc.body} />
  ) : (
    <div class="prose">
      <h1>Documentation</h1>
      <p>Welcome to the DataMgmt Node documentation.</p>

      <h2>Quick Start</h2>
      <pre><code>pip install datamgmtnode
datamgmtnode init --network sepolia
datamgmtnode start</code></pre>

      <h2>Sections</h2>
      <ul>
        <li><a href="/getting-started">Getting Started</a></li>
        <li><a href="/docs/user-guide/api-reference">API Reference</a></li>
        <li><a href="/docs/operations/deployment">Deployment</a></li>
        <li><a href="/docs/operations/security">Security</a></li>
      </ul>
    </div>
  )}
</DocsLayout>
