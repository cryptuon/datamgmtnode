---
import BaseLayout from '../../layouts/BaseLayout.astro';

const complianceCode = `# Record compliance event
POST /compliance/record
{
  "event_type": "data_shared",
  "data_hash": "abc123...",
  "recipient": "0x742d35Cc...",
  "timestamp": "2026-04-14T10:30:00Z"
}

# Response
{
  "tx_hash": "0x8f7a2b...",
  "block_number": 12345678,
  "verified": true,
  "explorer_url": "https://sepolia.etherscan.io/tx/0x8f7a2b..."
}`;

const configCode = `# .env configuration
BLOCKCHAIN_URL=https://your-chain-rpc.example.com
BLOCKCHAIN_TYPE=evm
CONTRACT_ADDRESS=0x...`;
---

<BaseLayout
  title="Blockchain Compliance - DataMgmt Node"
  description="Record all data operations on EVM-compatible blockchains for immutable audit trails. Support for Ethereum, Polygon, Arbitrum, and any EVM chain."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-primary-600 font-semibold text-sm uppercase tracking-wide">Feature</span>
        <h1 class="mt-2 text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight">
          Blockchain-Backed Compliance
        </h1>
        <p class="mt-6 text-xl text-gray-600 leading-relaxed">
          Every data sharing operation is cryptographically recorded on blockchain, creating immutable audit trails that satisfy GDPR, HIPAA, SOX, and other regulatory requirements.
        </p>
      </div>
    </div>
  </section>

  <!-- Key Stats -->
  <section class="py-12 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">100%</div>
          <div class="mt-1 text-sm text-gray-600">Immutable Records</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">40%</div>
          <div class="mt-1 text-sm text-gray-600">Audit Cost Reduction</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">EVM</div>
          <div class="mt-1 text-sm text-gray-600">Compatible Chains</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">&lt;1s</div>
          <div class="mt-1 text-sm text-gray-600">Verification Time</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">How Blockchain Compliance Works</h2>
      <p class="mt-4 text-lg text-gray-600 text-center max-w-2xl mx-auto">
        DataMgmt Node records every data operation as a blockchain transaction, creating tamper-proof evidence for regulatory audits.
      </p>

      <div class="mt-16 grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-bold">1</div>
            <div>
              <h3 class="font-semibold text-gray-900">Data Operation Occurs</h3>
              <p class="mt-1 text-gray-600">When data is shared, accessed, or modified, the node captures the operation details including timestamp, parties, and data hash.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-bold">2</div>
            <div>
              <h3 class="font-semibold text-gray-900">Event Encoding</h3>
              <p class="mt-1 text-gray-600">The operation is encoded as a compliance event with cryptographic signatures, ensuring authenticity and integrity.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-bold">3</div>
            <div>
              <h3 class="font-semibold text-gray-900">Blockchain Recording</h3>
              <p class="mt-1 text-gray-600">The event is submitted to the configured EVM blockchain as a transaction to the zero address, permanently recording the operation.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-bold">4</div>
            <div>
              <h3 class="font-semibold text-gray-900">Verification Available</h3>
              <p class="mt-1 text-gray-600">Anyone can verify the operation occurred by checking the blockchain transaction, providing independent third-party proof.</p>
            </div>
          </div>
        </div>
        <div class="bg-gray-900 rounded-xl p-6 text-sm font-mono text-green-400 overflow-x-auto">
          <pre class="whitespace-pre-wrap">{complianceCode}</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Chains -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">Supported Blockchains</h2>
      <p class="mt-4 text-lg text-gray-600 text-center max-w-2xl mx-auto">
        DataMgmt Node supports any EVM-compatible blockchain. Configure your preferred network based on cost, speed, and decentralization requirements.
      </p>

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
            <span class="text-2xl">⟠</span>
          </div>
          <h3 class="mt-4 font-semibold text-gray-900">Ethereum</h3>
          <p class="mt-2 text-sm text-gray-600">Maximum decentralization and security. Best for high-value compliance records.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
            <span class="text-2xl">⬡</span>
          </div>
          <h3 class="mt-4 font-semibold text-gray-900">Polygon</h3>
          <p class="mt-2 text-sm text-gray-600">Low transaction costs with fast finality. Ideal for high-volume operations.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
            <span class="text-2xl">◈</span>
          </div>
          <h3 class="mt-4 font-semibold text-gray-900">Arbitrum</h3>
          <p class="mt-2 text-sm text-gray-600">Ethereum security with L2 efficiency. Great balance of cost and security.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
            <span class="text-2xl">◉</span>
          </div>
          <h3 class="mt-4 font-semibold text-gray-900">Optimism</h3>
          <p class="mt-2 text-sm text-gray-600">Fast transactions with Ethereum security. Optimistic rollup technology.</p>
        </div>
      </div>

      <div class="mt-8 bg-white rounded-xl p-6 shadow-sm border border-gray-100">
        <h3 class="font-semibold text-gray-900">Custom EVM Chains</h3>
        <p class="mt-2 text-gray-600">Deploy on any EVM-compatible chain including private enterprise networks, Avalanche, BSC, or custom rollups. Simply configure the RPC endpoint.</p>
        <pre class="mt-4 bg-gray-900 rounded-lg p-4 text-sm font-mono text-green-400 overflow-x-auto">{configCode}</pre>
      </div>
    </div>
  </section>

  <!-- Compliance Standards -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">Regulatory Compliance Support</h2>
      <p class="mt-4 text-lg text-gray-600 text-center max-w-2xl mx-auto">
        Blockchain audit trails provide verifiable proof for multiple compliance frameworks.
      </p>

      <div class="mt-12 grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="text-4xl mb-4">🇪🇺</div>
          <h3 class="text-xl font-semibold text-gray-900">GDPR</h3>
          <p class="mt-3 text-gray-600">
            Demonstrate lawful data processing with immutable records of consent, data access, and deletion requests. Article 30 compliance made verifiable.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Processing records
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Consent tracking
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Right to erasure proof
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="text-4xl mb-4">🏥</div>
          <h3 class="text-xl font-semibold text-gray-900">HIPAA</h3>
          <p class="mt-3 text-gray-600">
            Maintain audit controls for protected health information (PHI) with cryptographic proof of access patterns and data integrity.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Access audit logs
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Integrity verification
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Breach notification proof
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-semibold text-gray-900">SOX</h3>
          <p class="mt-3 text-gray-600">
            Financial data integrity with tamper-proof records. Section 404 internal controls backed by blockchain verification.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Financial record integrity
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Change tracking
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Auditor access
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- API Reference -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">Compliance API Endpoints</h2>
      <p class="mt-4 text-lg text-gray-600 text-center max-w-2xl mx-auto">
        Integrate blockchain compliance into your applications with these endpoints.
      </p>

      <div class="mt-12 space-y-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3">
            <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-mono rounded">GET</span>
            <code class="text-sm font-mono">/verify_data/{"{hash}"}</code>
          </div>
          <p class="mt-3 text-gray-600">Verify that a data hash has been recorded on blockchain. Returns transaction details and verification status.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3">
            <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-mono rounded">POST</span>
            <code class="text-sm font-mono">/compliance/record</code>
          </div>
          <p class="mt-3 text-gray-600">Record a compliance event on blockchain. Accepts event type, data hash, and metadata.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3">
            <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-mono rounded">GET</span>
            <code class="text-sm font-mono">/compliance/events</code>
          </div>
          <p class="mt-3 text-gray-600">Retrieve compliance events with filtering by date range, event type, and data hash.</p>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a href="/docs/user-guide/api-reference" class="inline-flex items-center text-primary-600 font-medium hover:text-primary-700">
          View full API documentation
          <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-primary-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white">Start Recording Compliance Events</h2>
      <p class="mt-4 text-xl text-primary-100">
        Deploy a node and connect to any EVM blockchain in minutes.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/getting-started" class="inline-flex items-center justify-center px-6 py-3 bg-white text-primary-600 font-semibold rounded-lg hover:bg-primary-50 transition-colors">
          Get Started
        </a>
        <a href="/demo" class="inline-flex items-center justify-center px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors">
          Try Live Demo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
