---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureCard from '../../components/astro/FeatureCard.astro';
import JsonLd from '../../components/astro/JsonLd.astro';

const features = [
  {
    title: 'Blockchain Integration',
    description: 'Connect to any EVM-compatible blockchain including Ethereum, Polygon, Arbitrum, and Optimism. All compliance events are recorded on-chain for immutable audit trails.',
    href: '/features/blockchain',
    icon: 'blockchain',
  },
  {
    title: 'P2P Network',
    description: 'Kademlia DHT enables decentralized data distribution across 10,000+ nodes with O(log n) lookup efficiency, automatic peer discovery, and health monitoring.',
    href: '/features/p2p-network',
    icon: 'network',
  },
  {
    title: 'Data Sharing',
    description: 'Share encrypted data securely between organizations with built-in payment processing, access control, and compliance verification.',
    href: '/features/data-sharing',
    icon: 'lock',
  },
  {
    title: 'Compliance & Audit',
    description: 'Every data operation is cryptographically recorded on blockchain, creating tamper-proof audit trails for GDPR, HIPAA, SOX, and other regulatory requirements.',
    href: '/features/compliance',
    icon: 'compliance',
  },
  {
    title: 'Token Management',
    description: 'Built-in support for native tokens and ERC-20 tokens enables pay-per-access data monetization with blockchain-native payment processing.',
    href: '/features/tokens',
    icon: 'currency',
  },
  {
    title: 'Plugin Architecture',
    description: 'Extensible plugin system provides full access to node services for custom functionality including audit logging, webhooks, and data validation.',
    href: '/features/plugins',
    icon: 'plugin',
  },
];

const faqQuestions = [
  {
    "@type": "Question",
    "name": "What makes DataMgmt Node different from other data management platforms?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "DataMgmt Node combines blockchain for compliance, Kademlia DHT for P2P networking, and Fernet encryption for security in a single platform. Unlike centralized solutions, it provides data sovereignty, immutable audit trails, and built-in token payments."
    }
  },
  {
    "@type": "Question",
    "name": "Can DataMgmt Node integrate with existing enterprise systems?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, DataMgmt Node provides RESTful APIs (Internal, External, Dashboard) with rate limiting and validation. The plugin architecture allows custom integrations with any enterprise system."
    }
  }
];
---

<BaseLayout
  title="Features - DataMgmt Node"
  description="Explore DataMgmt Node's enterprise features: blockchain compliance, P2P networking, end-to-end encryption, token payments, and plugin architecture."
>
  <JsonLd type="FAQPage" data={{ questions: faqQuestions }} />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight">
        Enterprise-Grade Features
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-600">
        <strong>DataMgmt Node</strong> is a decentralized enterprise data management platform built for production environments with security, compliance, and scalability in mind.
      </p>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            href={feature.href}
            icon={feature.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Highlights -->
  <section class="py-16 sm:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">Technical Highlights</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600">480,000</div>
          <div class="mt-2 text-gray-600">PBKDF2 iterations for key derivation</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600">O(log n)</div>
          <div class="mt-2 text-gray-600">Kademlia DHT lookup efficiency</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary-600">3 APIs</div>
          <div class="mt-2 text-gray-600">Internal, External, Dashboard with WebSocket</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">Frequently Asked Questions</h2>
      <div class="mt-12 space-y-8">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">What makes DataMgmt Node different from other data management platforms?</h3>
          <p class="mt-2 text-gray-600">
            DataMgmt Node combines blockchain for compliance, Kademlia DHT for P2P networking, and Fernet encryption for security in a single platform. Unlike centralized solutions, it provides data sovereignty, immutable audit trails, and built-in token payments.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Can DataMgmt Node integrate with existing enterprise systems?</h3>
          <p class="mt-2 text-gray-600">
            Yes, DataMgmt Node provides RESTful APIs (Internal, External, Dashboard) with rate limiting and validation. The plugin architecture allows custom integrations with any enterprise system.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 sm:py-24 bg-primary-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white">Ready to explore?</h2>
      <p class="mt-4 text-xl text-primary-100">
        Try the live demo or read the documentation to learn more.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/demo" class="px-6 py-3 bg-white text-primary-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Live Demo
        </a>
        <a href="/docs" class="px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
          Read Docs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
