---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/astro/JsonLd.astro';

const healthResponse = `{
  "status": "healthy",
  "components": {
    "blockchain": "connected",
    "p2p_network": "connected",
    "encryption": "active"
  }
}`;

const steps = [
  {
    name: "Install DataMgmt Node",
    text: "Run pip install datamgmtnode to install the Python package"
  },
  {
    name: "Initialize Configuration",
    text: "Run datamgmtnode init to create the configuration file"
  },
  {
    name: "Configure Environment",
    text: "Set your blockchain RPC URL and other environment variables in .env"
  },
  {
    name: "Start the Node",
    text: "Run datamgmtnode start to launch your node"
  }
];
---

<BaseLayout
  title="Getting Started - DataMgmt Node"
  description="Get started with DataMgmt Node in minutes. Install, configure, and deploy your first decentralized data management node."
>
  <JsonLd type="HowTo" data={{
    name: "How to Install and Run DataMgmt Node",
    description: "Step-by-step guide to installing and running DataMgmt Node",
    step: steps
  }} />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight">
        Getting Started
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-600">
        Deploy your first DataMgmt Node in under 5 minutes. This guide covers installation, configuration, and your first data share.
      </p>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900">Quick Start</h2>

      <!-- Step 1 -->
      <div class="mt-8">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 text-sm font-bold">1</span>
          Install DataMgmt Node
        </h3>
        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-gray-100 font-mono text-sm"><code>pip install datamgmtnode</code></pre>
        </div>
        <p class="mt-3 text-gray-600">
          DataMgmt Node requires Python 3.10 or higher. We recommend using a virtual environment.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 text-sm font-bold">2</span>
          Initialize Configuration
        </h3>
        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-gray-100 font-mono text-sm"><code>datamgmtnode init --network sepolia</code></pre>
        </div>
        <p class="mt-3 text-gray-600">
          This creates a <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">.env</code> file and required directories. Use <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">--network mainnet</code> for production.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 text-sm font-bold">3</span>
          Configure Environment
        </h3>
        <p class="mt-3 text-gray-600">
          Edit the <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">.env</code> file with your configuration:
        </p>
        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-gray-100 font-mono text-sm"><code># Required
KEY_MASTER_PASSWORD=your-secure-password
BLOCKCHAIN_URL=https://sepolia.infura.io/v3/YOUR_KEY
PRIVATE_KEY=0x...

# Optional
NODE_ID=my-node-1
P2P_PORT=8000
INITIAL_PEERS=</code></pre>
        </div>
        <div class="mt-4 p-4 bg-yellow-50 border border-yellow-100 rounded-lg">
          <p class="text-sm text-yellow-800">
            <strong>Security:</strong> Never commit your <code>.env</code> file to version control. Use a strong, unique master password.
          </p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 text-sm font-bold">4</span>
          Start the Node
        </h3>
        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-gray-100 font-mono text-sm"><code>datamgmtnode start</code></pre>
        </div>
        <p class="mt-3 text-gray-600">
          Your node will start with three APIs:
        </p>
        <ul class="mt-2 space-y-1 text-gray-600">
          <li>&bull; Internal API: <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">http://localhost:8080</code></li>
          <li>&bull; External API: <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">http://0.0.0.0:8081</code></li>
          <li>&bull; Dashboard API: <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">http://localhost:8082</code></li>
        </ul>
      </div>

      <!-- Step 5 -->
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 text-sm font-bold">5</span>
          Verify Installation
        </h3>
        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-gray-100 font-mono text-sm"><code>curl http://localhost:8080/health</code></pre>
        </div>
        <p class="mt-3 text-gray-600">
          You should see a JSON response with status "healthy":
        </p>
        <div class="mt-4 bg-gray-900 rounded-lg p-4 overflow-x-auto">
          <pre class="text-gray-100 font-mono text-sm"><code>{healthResponse}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Next -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900">What's Next?</h2>
      <div class="mt-8 grid sm:grid-cols-2 gap-6">
        <a href="/docs/user-guide/data-sharing" class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900">Share Your First Data</h3>
          <p class="mt-2 text-sm text-gray-600">Learn how to encrypt and share data with other nodes.</p>
        </a>
        <a href="/docs/user-guide/api-reference" class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900">API Reference</h3>
          <p class="mt-2 text-sm text-gray-600">Complete documentation of all API endpoints.</p>
        </a>
        <a href="/docs/operations/deployment" class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900">Production Deployment</h3>
          <p class="mt-2 text-sm text-gray-600">Deploy with Docker, Kubernetes, or systemd.</p>
        </a>
        <a href="/demo" class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900">Try the Demo</h3>
          <p class="mt-2 text-sm text-gray-600">Interact with a live node on the Sepolia testnet.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- System Requirements -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900">System Requirements</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th class="text-left p-3 bg-gray-100 font-semibold">Component</th>
              <th class="text-left p-3 bg-gray-100 font-semibold">Minimum</th>
              <th class="text-left p-3 bg-gray-100 font-semibold">Recommended</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="p-3">Python</td>
              <td class="p-3">3.10+</td>
              <td class="p-3">3.12+</td>
            </tr>
            <tr class="border-b">
              <td class="p-3">RAM</td>
              <td class="p-3">2 GB</td>
              <td class="p-3">8 GB</td>
            </tr>
            <tr class="border-b">
              <td class="p-3">Storage</td>
              <td class="p-3">10 GB</td>
              <td class="p-3">100 GB+ (SSD)</td>
            </tr>
            <tr class="border-b">
              <td class="p-3">Network</td>
              <td class="p-3">10 Mbps</td>
              <td class="p-3">100 Mbps</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
