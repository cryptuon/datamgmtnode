---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/astro/JsonLd.astro';

const features = [
  {
    title: 'Blockchain Compliance',
    description: 'Every data sharing operation is recorded on EVM-compatible blockchains, creating immutable audit trails for GDPR, HIPAA, and SOX compliance.',
  },
  {
    title: 'P2P Network',
    description: 'Kademlia DHT enables decentralized data distribution across 10,000+ nodes with O(log n) lookup efficiency and automatic peer discovery.',
  },
  {
    title: 'End-to-End Encryption',
    description: 'Fernet encryption (AES-128-CBC) with PBKDF2 key derivation using 480,000 iterations ensures data security at rest and in transit.',
  },
  {
    title: 'Token Payments',
    description: 'Built-in ERC-20 token support enables pay-per-access data monetization with native blockchain payment processing.',
  },
  {
    title: 'Plugin Architecture',
    description: 'Extensible plugin system allows custom functionality including audit logging, webhooks, and data validation.',
  },
  {
    title: 'RESTful APIs',
    description: 'Three API layers (Internal, External, Dashboard) with rate limiting, validation, and WebSocket support for real-time updates.',
  },
];

const comparisons = [
  { feature: 'Decentralized', datamgmt: true, ipfs: true, aws: false },
  { feature: 'Compliance Audit Trail', datamgmt: 'Blockchain', ipfs: 'No', aws: 'CloudTrail' },
  { feature: 'Token Payments', datamgmt: true, ipfs: false, aws: false },
  { feature: 'End-to-End Encryption', datamgmt: true, ipfs: 'Optional', aws: 'At-rest' },
  { feature: 'Self-Hosted', datamgmt: true, ipfs: true, aws: false },
];

const faqQuestions = [
  {
    "@type": "Question",
    "name": "What is DataMgmt Node?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "DataMgmt Node is a decentralized enterprise data management platform that uses blockchain for compliance audit trails, Kademlia DHT for P2P networking, and Fernet encryption for end-to-end security."
    }
  },
  {
    "@type": "Question",
    "name": "What blockchains does DataMgmt Node support?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "DataMgmt Node supports all EVM-compatible blockchains including Ethereum, Polygon, Arbitrum, and Optimism."
    }
  },
  {
    "@type": "Question",
    "name": "How does DataMgmt Node ensure compliance?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "DataMgmt Node records all data sharing operations on blockchain as immutable transactions, creating tamper-proof audit trails suitable for GDPR, HIPAA, and SOX compliance requirements."
    }
  }
];
---

<BaseLayout
  title="DataMgmt Node - Decentralized Enterprise Data Management"
  description="DataMgmt Node is a decentralized enterprise data management platform with blockchain compliance, P2P networking, and end-to-end encryption. Share data securely across organizations."
>
  <JsonLd type="SoftwareApplication" />
  <JsonLd type="FAQPage" data={{ questions: faqQuestions }} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white py-20 sm:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 tracking-tight">
          Decentralized Data Management
          <span class="block text-primary-600">for the Enterprise</span>
        </h1>
        <p class="mt-6 max-w-2xl mx-auto text-xl text-gray-600">
          <strong>DataMgmt Node</strong> is a decentralized enterprise data management platform that combines blockchain technology, peer-to-peer networking, and end-to-end encryption for secure, compliant data sharing.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/getting-started"
            class="inline-flex items-center px-6 py-3 rounded-lg bg-primary-500 text-white font-semibold hover:bg-primary-600 transition-colors"
          >
            Get Started
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="/demo"
            class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-gray-300 text-gray-700 font-semibold hover:border-gray-400 transition-colors"
          >
            Live Demo
          </a>
        </div>

        <!-- Quick Install -->
        <div class="mt-10">
          <div class="inline-flex items-center gap-3 px-4 py-2 bg-gray-900 rounded-lg text-gray-100 font-mono text-sm">
            <span class="text-gray-400">$</span>
            <code>pip install datamgmtnode</code>
            <button
              class="text-gray-400 hover:text-white transition-colors"
              onclick="navigator.clipboard.writeText('pip install datamgmtnode')"
              title="Copy to clipboard"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem/Solution Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">The Problem with Centralized Data</h2>
          <ul class="mt-6 space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-600">Single point of failure creates data availability risks</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-600">Vendor lock-in limits data sovereignty and control</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-gray-600">Compliance audits require trust in third-party logs</span>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="text-3xl font-bold text-gray-900">The DataMgmt Node Solution</h2>
          <ul class="mt-6 space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">P2P distribution ensures data availability across nodes</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Self-hosted nodes give you complete data sovereignty</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-600">Blockchain-backed audit trails are immutable and verifiable</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900">Enterprise-Grade Features</h2>
        <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">
          Built for production environments with security, compliance, and scalability in mind.
        </p>
      </div>
      <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">{feature.title}</h3>
            <p class="mt-2 text-gray-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900">How We Compare</h2>
        <p class="mt-4 text-xl text-gray-600">
          See how DataMgmt Node stacks up against other solutions.
        </p>
      </div>
      <div class="mt-12 overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="text-left p-4 bg-gray-100 font-semibold">Feature</th>
              <th class="p-4 bg-primary-100 font-semibold text-primary-800">DataMgmt Node</th>
              <th class="p-4 bg-gray-100 font-semibold">IPFS</th>
              <th class="p-4 bg-gray-100 font-semibold">AWS S3</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr class="border-b border-gray-100">
                <td class="p-4 font-medium">{row.feature}</td>
                <td class="p-4 text-center bg-primary-50">
                  {typeof row.datamgmt === 'boolean' ? (
                    row.datamgmt ? '✓' : '✗'
                  ) : (
                    <span class="text-primary-700 font-medium">{row.datamgmt}</span>
                  )}
                </td>
                <td class="p-4 text-center">
                  {typeof row.ipfs === 'boolean' ? (
                    row.ipfs ? '✓' : '✗'
                  ) : (
                    <span class="text-gray-600">{row.ipfs}</span>
                  )}
                </td>
                <td class="p-4 text-center">
                  {typeof row.aws === 'boolean' ? (
                    row.aws ? '✓' : '✗'
                  ) : (
                    <span class="text-gray-600">{row.aws}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-8 text-center">
        <a href="/compare" class="text-primary-600 hover:text-primary-700 font-medium">
          View full comparison &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900">Use Cases</h2>
        <p class="mt-4 text-xl text-gray-600">
          Trusted by enterprises across industries for secure data management.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/use-cases/healthcare" class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900 group-hover:text-primary-600">Healthcare</h3>
          <p class="mt-2 text-sm text-gray-600">HIPAA-compliant data exchange between providers</p>
        </a>
        <a href="/use-cases/finance" class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900 group-hover:text-primary-600">Financial Services</h3>
          <p class="mt-2 text-sm text-gray-600">SOX-compliant data sharing with audit trails</p>
        </a>
        <a href="/use-cases/supply-chain" class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900 group-hover:text-primary-600">Supply Chain</h3>
          <p class="mt-2 text-sm text-gray-600">Document verification across partners</p>
        </a>
        <a href="/use-cases/monetization" class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900 group-hover:text-primary-600">Data Monetization</h3>
          <p class="mt-2 text-sm text-gray-600">Token-gated access to proprietary datasets</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-primary-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white">Ready to Get Started?</h2>
      <p class="mt-4 text-xl text-primary-100 max-w-2xl mx-auto">
        Deploy your first DataMgmt Node in minutes. Open source, MIT licensed, free forever.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/getting-started"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-white text-primary-600 font-semibold hover:bg-gray-100 transition-colors"
        >
          Read the Docs
        </a>
        <a
          href="https://github.com/cryptuon/datamgmtnode"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-white text-white font-semibold hover:bg-white/10 transition-colors"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center">Frequently Asked Questions</h2>
      <div class="mt-12 space-y-8">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">What is DataMgmt Node?</h3>
          <p class="mt-2 text-gray-600">
            <strong>DataMgmt Node</strong> is a decentralized enterprise data management platform that uses blockchain for compliance audit trails, Kademlia DHT for P2P networking, and Fernet encryption for end-to-end security.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">What blockchains does DataMgmt Node support?</h3>
          <p class="mt-2 text-gray-600">
            DataMgmt Node supports all EVM-compatible blockchains including Ethereum, Polygon, Arbitrum, and Optimism. You can configure your node to connect to any chain with a standard JSON-RPC endpoint.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">How does DataMgmt Node ensure compliance?</h3>
          <p class="mt-2 text-gray-600">
            DataMgmt Node records all data sharing operations on blockchain as immutable transactions, creating tamper-proof audit trails suitable for GDPR, HIPAA, and SOX compliance requirements.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Is DataMgmt Node free to use?</h3>
          <p class="mt-2 text-gray-600">
            Yes, DataMgmt Node is fully open source under the MIT license. You can self-host it for free. The only costs are your infrastructure and blockchain gas fees for compliance recording.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
